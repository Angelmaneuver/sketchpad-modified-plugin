msgid "Set as a background image"
msgstr "背景画像を設定"

#: includes/admin/pages/class-extend-settings-page.php:517
msgid "Change the background image"
msgstr "背景画像を変更"

#: includes/admin/pages/class-extend-settings-page.php:518
msgid "Remove the background image"
msgstr "背景画像を削除"

#: includes/admin/pages/class-extend-settings-page.php:525
