msgid "Extend all article titles"
msgstr "全ての記事タイトルを拡張する"

#: includes/admin/pages/class-extend-settings-page.php:461
msgid "* The title of the article is set at location specified by the \"{title}\" keyword."
msgstr "* 記事のタイトルが、\"{title}\"キーワードで指定された箇所に設定されます。"

#: includes/admin/pages/class-extend-settings-page.php:482
msgid "Extend all page titles"
msgstr "全てのページタイトルを拡張する"

#: includes/admin/pages/class-extend-settings-page.php:488
msgid "* The title of the page is set at location specified by the \"{title}\" keyword."
msgstr "* ページのタイトルが、\"{title}\"キーワードで指定された箇所に設定されます。"

#: includes/admin/pages/class-extend-settings-page.php:518
msgid "Background image"
msgstr "背景画像"

#: includes/admin/pages/class-extend-settings-page.php:525
#: includes/admin/pages/class-extend-settings-page.php:527
msgid "Select a background image"
msgstr "背景画像を選択"

#: includes/admin/pages/class-extend-settings-page.php:526
msgid "Set as a background image"
msgstr "背景画像を設定"

#: includes/admin/pages/class-extend-settings-page.php:528
msgid "Change the background image"
msgstr "背景画像を変更"

#: includes/admin/pages/class-extend-settings-page.php:529
