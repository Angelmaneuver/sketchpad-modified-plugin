#: includes/admin/pages/class-extend-settings-page.php:271
msgid "Article Title Setting"
msgstr "記事タイトル設定"

#: includes/admin/pages/class-extend-settings-page.php:273
msgid "Please enter if you want to add text to all article titles."
msgstr "全ての記事のタイトルにテキストを追加したい場合は、ここに入力してください。"

#: includes/admin/pages/class-extend-settings-page.php:280
msgid "Page Title Setting"
msgstr "ページタイトル設定"

#: includes/admin/pages/class-extend-settings-page.php:282
msgid "Please enter if you want to add text to all page titles."
msgstr "全てのページのタイトルにテキストを追加したい場合は、ここに入力してください。"

